{
  "name": "facturas-workspace",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "pnpm exec turbo build",
    "changeset": "changeset",
    "check:docs": "node scripts/check-docs.mjs",
    "docs:sync": "cp README.md packages/arca/README.md",
    "typecheck": "pnpm exec turbo typecheck && pnpm typecheck:examples",
    "typecheck:examples": "pnpm exec tsc --project tsconfig.examples.json --noEmit",
    "test": "pnpm exec turbo test",
    "test:coverage": "pnpm --filter facturas test:coverage",
    "check": "pnpm exec ultracite check",
    "fix": "pnpm exec ultracite fix",
    "pack:check": "pnpm --filter facturas pack:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@changesets/cli": "^3.0.2",
    "@types/node": "^22.20.2",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "ultracite": "7.11.1"
  }
}
